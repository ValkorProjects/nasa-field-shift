# npm run dev (local development): call the backend running on this machine.
# Vite proxies /api to VITE_BACKEND_URL, so there is no CORS issue. Start the backend with
#   cd backend && fastapi dev main.py        (http://localhost:8000)
# Without a backend, use `npm run dev:mock` (sample data).
VITE_API_MODE=api
VITE_BACKEND_URL=http://localhost:8000
