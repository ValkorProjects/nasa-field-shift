# vite build (production, e.g. Vercel deploys of `main`): call the published backend directly.
# The backend allows CORS from any origin. Vercel preview builds (the `dev` branch and pull requests)
# are switched to http://localhost:8000 in vite.config.js.
VITE_API_MODE=api
VITE_API_BASE=https://rollcrop-backend.vercel.app
