# Per-mode defaults are committed: .env.development (npm run dev → local backend),
# .env.production (build → https://rollcrop-backend.vercel.app) and .env.mock (npm run dev:mock).
# To override on your machine, copy this file to .env.local (never commit .env.local).
# mock = use the sample JSON in src/api/mock/ · api = call the backend at /api
VITE_API_MODE=mock
# Backend used by the dev proxy for /api
VITE_BACKEND_URL=http://localhost:8000
# Production build only (no proxy there): full backend URL, e.g. https://field-shift-api.example.com
# Leave empty in dev.
VITE_API_BASE=
